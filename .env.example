# AI provider credentials. User-saved keys in the profile page take priority per request.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# OpenAI-compatible provider settings.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# Legacy fallback model name. Provider-specific model variables above take priority.
AI_MODEL=

# JWT and login session settings.
# IMPORTANT: Set a strong random secret (32+ chars) in production!
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=2592000

# CORS allowed origins (comma-separated). In production, restrict to your frontend domain.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Redis-backed captcha, login state, and user cache settings.
# 本地（非容器）开发时若连容器 Redis，请使用带密码的 redis://:<REDIS_PASSWORD>@127.0.0.1:6379/0
REDIS_URL=redis://127.0.0.1:6379/0
CAPTCHA_TTL_SECONDS=300
USER_CACHE_TTL_SECONDS=86400
USER_SETTINGS_CACHE_TTL_SECONDS=3600
CHAT_CONTEST_TTL=3600
STOP_GENERATION_TTL_SECONDS=300

# pgSQL connection. 本地开发指向本机（容器 db 映射在 127.0.0.1:55432，
# 用 55432 而非 5432 是为了避开 WSL 的 wslrelay 抢占 5432）。
# 生产/容器内连接串由 docker-compose.yml 用 POSTGRES_PASSWORD 组装，无需在此维护。
DATABASE_URL=postgresql+psycopg://postgres:${POSTGRES_PASSWORD}@127.0.0.1:55432/aichat

# ---- Docker Compose 专用密码（仅 compose 使用，不用于本地直连）----
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=change-me-strong
REDIS_PASSWORD=change-me-strong

# RAG settings. pgvector dimension must match the embedding model.
RAG_ENABLED=true
RAG_UPLOAD_DIR=backend/uploads/rag
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
RAG_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
RAG_EMBEDDING_DIMENSION=1024
RAG_TOP_K=5
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150
RAG_MAX_CONTEXT_CHARS=5000

# Optional admin bootstrap account for first-run setup.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin123456

# ---- 生产运维（阶段 4）----
# DB 连接池：pre_ping 会先探活再取连接，数据库重启后不会"第一次查询必失败"
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_POOL_PRE_PING=true

# Celery：软超时留给任务收尾，硬超时由 worker 强杀；RAG 任务有限重试
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=120
CELERY_TASK_TIME_LIMIT_SECONDS=180
CELERY_TASK_MAX_RETRIES=3
CELERY_RETRY_BACKOFF_SECONDS=10
# 队列积压超过该值，/health/ready 标记 degraded（不摘流）
CELERY_QUEUE_BACKLOG_THRESHOLD=100

# 指标：GET /metrics（Prometheus 文本）。
# - 未设 METRICS_TOKEN：仅放行回环地址（同机 Prometheus 抓取）
# - 设了 METRICS_TOKEN：要求 Authorization: Bearer <token>（或 ?token=）
METRICS_ENABLED=true
METRICS_TOKEN=
# /health/ready 失败时是否回显 DB/Redis 异常原文（可能含连接串/主机名）。
# 排障时临时设 true，平时保持 false
HEALTH_EXPOSE_DETAILS=false
# 部署环境：production 下 JWT 默认/过短密钥直接拒绝启动
ENVIRONMENT=dev
# 生产建议设为 true，一行一个 JSON，便于采集系统解析
LOG_JSON=false
# 仅当直连方 IP 在名单内才采信 X-Forwarded-For；"*" 表示全信任
# 例如：TRUSTED_PROXY_IPS=127.0.0.1,10.0.0.2
TRUSTED_PROXY_IPS=
# 停机宽限期（秒），与 docker-compose 的 graceful shutdown 对齐
SHUTDOWN_GRACE_SECONDS=30

# 用户没在前端存 API Key 时，是否回落到服务器全局 Key。
# 默认关闭（公开注册站点开着等于谁都能白嫖服务器额度）；
# 自用部署想省事可设 true
SERVER_API_KEY_FALLBACK_ENABLED=false

# ---- Docker Compose 说明 ----
# 本文件的密钥/模型配置会被 docker compose 通过 env_file 注入容器，直接复用即可。
# 容器内的连接串由 docker-compose.yml 的 environment 强制覆盖为服务名地址，无需改动：
#   DATABASE_URL -> postgresql+psycopg://postgres:${POSTGRES_PASSWORD}@db:5432/aichat
#   REDIS_URL    -> redis://:${REDIS_PASSWORD}@redis:6379/0
# RAG_UPLOAD_DIR 的相对路径 backend/uploads/rag 挂载在 backend-uploads 卷上，
# 由 backend 与 worker 容器共享。
#
# API 密钥（DEEPSEEK_API_KEY / OPENAI_API_KEY / TAVILY_API_KEY / RAG_EMBEDDING_API_KEY）：
# 容器内优先从 ./secrets/ 目录（只读挂载到 /run/secrets/）读取同名文件，避免密钥
# 出现在容器环境变量（docker inspect 可见）。secrets/ 已加入 .gitignore / .dockerignore。
# 初始化：mkdir secrets && cp .env 中对应密钥到 secrets/<key_name> 文件（每行一个值）。
# 注意：请勿使用开发密钥（tvly-dev-*）上生产，请到服务商控制台申请正式 key。
