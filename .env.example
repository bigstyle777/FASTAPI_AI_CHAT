# AI provider credentials. User-saved keys in the profile page take priority per request.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# OpenAI-compatible provider settings.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# Legacy fallback model name. Provider-specific model variables above take priority.
AI_MODEL=

# JWT and login session settings.
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=2592000

# Redis-backed captcha, login state, and user cache settings.
REDIS_URL=redis://127.0.0.1:6379/0
CAPTCHA_TTL_SECONDS=300
USER_CACHE_TTL_SECONDS=86400
USER_SETTINGS_CACHE_TTL_SECONDS=3600
CHAT_CONTEST_TTL=3600
STOP_GENERATION_TTL_SECONDS=300

# pgSQL connection.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/aichat

# RAG settings. pgvector dimension must match the embedding model.
RAG_ENABLED=true
RAG_UPLOAD_DIR=backend/uploads/rag
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
RAG_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
RAG_EMBEDDING_DIMENSION=1024
RAG_TOP_K=5
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150
RAG_MAX_CONTEXT_CHARS=5000

# Optional admin bootstrap account for first-run setup.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin123456
